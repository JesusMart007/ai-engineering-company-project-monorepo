# Copy to .env (never commit .env). Used by docker-compose.yml.
# Generate a key with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Allowed browser origins for the API
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

RESEND_API_KEY=re_your_api_key
EMAIL_FROM=onboarding@resend.dev
FRONTEND_URL=http://localhost:3001
RESET_TOKEN_EXPIRE_MINUTES=30

# Supabase Postgres (transaction pooler URI). Never commit the real value.
DATABASE_URL=postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@<region>.pooler.supabase.com:6543/postgres

# Service-to-service URL on the Docker network (service name, not localhost)
API_INTERNAL_URL=http://api:8000
