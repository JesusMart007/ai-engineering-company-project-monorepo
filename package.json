{
  "name": "ai-engineering-company-project-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "TypeScript milestone validation scripts",
  "workspaces": [
    "packages/*",
    "uis/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "demo": "tsx src/demo.ts",
    "dev:website": "npm run dev --workspace @nexova/website",
    "dev:backoffice": "npm run dev --workspace @nexova/backoffice",
    "dev:talent": "npm run dev --workspace talent-pipeline-tracker",
    "dev:api": ".venv/bin/python -m uvicorn app.main:app --reload --app-dir services/api",
    "lint": "npm run lint --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "test:api": "PYTHONPATH=services/api .venv/bin/python -m pytest services/api/tests"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "tsx": "^4.19.1"
  }
}
